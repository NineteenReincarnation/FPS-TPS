<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Anno.FpsTps.RuntimeSmoke</AssemblyName>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RimWorldPath Condition="'$(RimWorldPath)' == ''">D:\Steam\steamapps\common\RimWorld</RimWorldPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Source/FpsTps/FpsTps.csproj" />
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldPath)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(RimWorldPath)\UnityStubs.dll" Private="false" />
    <Reference Include="Waylith" HintPath="$(RimWorldPath)\Waylith.dll" Private="false" />
  </ItemGroup>
</Project>
