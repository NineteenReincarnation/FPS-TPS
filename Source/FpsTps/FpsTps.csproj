<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Anno.FpsTps</AssemblyName>
    <RootNamespace>Anno.FpsTps</RootNamespace>
    <Version>1.1.0</Version>
    <Deterministic>true</Deterministic>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RimWorldPath Condition="'$(RimWorldPath)' == ''">D:\Steam\steamapps\common\RimWorld</RimWorldPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorldPath)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(RimWorldPath)\UnityStubs.dll" Private="false" />
    <Reference Include="Waylith" HintPath="$(RimWorldPath)\Waylith.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RimWorldPath)\Assembly-CSharp.dll')" Text="Set RimWorldPath to a RimWorld 1.7 installation." />
  </Target>
</Project>
